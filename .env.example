# ============================================
# XYKEEL — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Parsing rules (verified from src/config/config.ts):
#   String:  process.env[key] ?? "" — empty string remains empty string
#   Integer: parseInt(raw, 10) — invalid/missing resolves to default
#   Boolean: true when raw === "true" || raw === "1" (case-insensitive) — other values = false
#
# Raven Host deployment:
#   npm install → npm run build → npm start
#   This process does NOT include a Minecraft server or AI model.
#   You must provide those externally and point this app to them.
#
# Test server (Wispbyte integration test):
#   MC_HOST=bot.progamer.me
#   MC_PORT=24703
#   MC_VERSION=1.21.11
#   MC_USERNAME=Xykeel
#   MC_AUTH=offline

# ============================================
# Minecraft
# ============================================
# MC_HOST: server address. Use "127.0.0.1" or "localhost" only when
#          Minecraft runs on the same host/container as Xykeel.
MC_HOST=localhost
# MC_PORT: default Minecraft Java Edition port
MC_PORT=25565
# MC_VERSION: Minecraft server version (must match server)
MC_VERSION=1.21.11
# MC_USERNAME: in-game username for offline mode (default: Xykeel)
MC_USERNAME=Xykeel

# --- Authentication ---
# MC_AUTH: "offline" (independent bot, no Microsoft account) or "microsoft"
#   - offline: MC_EMAIL and MC_PASSWORD are ignored (forced to "")
#   - microsoft: MC_EMAIL is REQUIRED; throws if missing
MC_AUTH=offline
# MC_EMAIL: required only when MC_AUTH=microsoft
MC_EMAIL=
# MC_PASSWORD: optional for Microsoft auth (used if needed)
MC_PASSWORD=

# ============================================
# AI Global Settings
# ============================================
# AI_PROVIDER: override primary provider name (empty = use priority order)
AI_PROVIDER=
# AI_ALLOW_PAID_PROVIDERS: when false, OpenAI/Anthropic/Vertex/Azure are disabled
AI_ALLOW_PAID_PROVIDERS=false

# ============================================
# AI Provider Slots (30 providers, priority order)
# ============================================
# Each provider supports:
#   AI_<PROVIDER>_ENABLED  — "true" to enable (default: "true")
#   AI_<PROVIDER>_API_KEY  — API key (empty = skipped; enabled+no-key = config_error)
#   AI_<PROVIDER>_MODEL    — model override (empty = built-in default)
#   AI_<PROVIDER>_BASE_URL — API endpoint (empty = built-in default)
#
# Providers without an API key or with placeholder URLs are skipped.
# Paid providers (anthropic, openai, vertex, azure) require AI_ALLOW_PAID_PROVIDERS=true.
# Providers are tried in priority order (1-30), then Raven, then deterministic local fallback.

# Provider 1: OpenAI (paid — requires AI_ALLOW_PAID_PROVIDERS=true)
AI_OPENAI_ENABLED=false
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-3.5-turbo
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# Provider 2: Anthropic (paid — requires AI_ALLOW_PAID_PROVIDERS=true)
AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_BASE_URL=

# Provider 3: Gemini
AI_GEMINI_ENABLED=false
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
AI_GEMINI_BASE_URL=

# Provider 4: Vertex (paid — requires AI_ALLOW_PAID_PROVIDERS=true)
AI_VERTEX_ENABLED=false
AI_VERTEX_API_KEY=
AI_VERTEX_MODEL=
AI_VERTEX_BASE_URL=

# Provider 5: Groq
AI_GROQ_ENABLED=false
AI_GROQ_API_KEY=
AI_GROQ_MODEL=llama-3.1-8b-instant
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider 6: DeepSeek
AI_DEEPSEEK_ENABLED=false
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


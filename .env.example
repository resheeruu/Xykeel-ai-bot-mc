# ============================================
# XYKEEL — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Minecraft Authentication ---
# Email or username for Microsoft/online authentication
MC_EMAIL=
# Password (if using offline/cracked mode — NOT recommended for production)
MC_PASSWORD=
# Auth type: "microsoft" (default) | "offline"
MC_AUTH=offline

# --- Server Connection ---
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21.1
MC_USERNAME=Xykeel

# --- Owner Identity ---
# Your Minecraft UUID (stable identifier — not your username)
OWNER_UUID=
# Your Minecraft username (for display only)
OWNER_USERNAME=

# --- AI Provider ---
# "local" (deterministic fallback) | "openai" | "ollama"
AI_PROVIDER=local
# Only needed for remote providers
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Autonomy ---
# How often (ms) Xykeel runs his decision loop
AUTONOMY_INTERVAL=30000
# Delay (ms) after human disconnects before Xykeel connects
HANDOFF_DELAY=30000
# Max reconnect attempts before giving up
MAX_RECONNECT_ATTEMPTS=5

# --- Logging ---
# "error" | "warn" | "info" | "debug"
LOG_LEVEL=info
# "console" | "file" | "both"
LOG_OUTPUT=both
LOG_PATH=./data/logs

# --- Persistence ---
STORAGE_PATH=./data

# --- Server-Specific (Lunamoon SMP) ---
# Fill these in when deploying to Lunamoon
SERVER_NAME=lunamoon

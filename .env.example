# ============================================
# Raven AI (optional — tried after all 30 provider slots are exhausted)
# ============================================
# Raven is a local/remote LLM endpoint (e.g. Ollama, llama.cpp, or any
# OpenAI-compatible API). It is NOT provided by Raven Host.
AI_RAVEN_ENABLED=false
AI_RAVEN_BASE_URL=http://127.0.0.1:11434/v1
AI_RAVEN_MODEL=
AI_RAVEN_API_KEY=
AI_RAVEN_TIMEOUT_MS=30000

# ============================================
# Autonomy
# ============================================
# AUTONOMY_INTERVAL: decision loop interval in ms
AUTONOMY_INTERVAL=30000
# MAX_RECONNECT_ATTEMPTS: max reconnect attempts before giving up
MAX_RECONNECT_ATTEMPTS=10
# RECONNECT_BASE_DELAY: base delay (ms) for exponential backoff reconnect
RECONNECT_BASE_DELAY=2000
# RECONNECT_MAX_DELAY: max delay (ms) for exponential backoff reconnect
RECONNECT_MAX_DELAY=60000

# ============================================
# Logging
# ============================================
# LOG_LEVEL: "error" | "warn" | "info" | "debug"
LOG_LEVEL=info
# LOG_OUTPUT: "console" | "file" | "both"
LOG_OUTPUT=both
# LOG_PATH: directory for log files (relative to project root)
LOG_PATH=./data/logs

# ============================================
# Persistence
# ============================================
# STORAGE_PATH: directory for memory, provider quota, and other data files
STORAGE_PATH=./data

# ============================================
# Server
# ============================================
# SERVER_NAME: optional server name identifier
SERVER_NAME=
# HEALTH_PORT: port for the minimal health HTTP endpoint (0 to disable)
HEALTH_PORT=3000
